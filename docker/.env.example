# Temporal Cloud connection details for order-service.
# Copy this file to docker/.env and fill in real values — .env is gitignored.
#
# TEMPORAL_SERVICE_ADDRESS: the namespace's gRPC endpoint, format <namespace>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE: the namespace itself, e.g. myapp.a2dd6
# TEMPORAL_API_KEY: an API key created for this namespace (Temporal Cloud UI → API Keys)

TEMPORAL_SERVICE_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_API_KEY=
